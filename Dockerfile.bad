# Не минимальный образ, ещё и без фиксированного тега (latest)
FROM apache/airflow:latest

# Работаем всегда под root, non-root user игнорируется
USER root

# Нет фиксированных настроек, часть конфигурации захардкожена
ENV AIRFLOW__CORE__LOAD_EXAMPLES=True
ENV AIRFLOW__CORE__EXECUTOR=LocalExecutor
ENV AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db

# Кладём всё подряд в один слой — хуже кеширование
COPY . /aith_containers

# Установка зависимостей без requirements.txt,
# без очистки кешей - тяжёлый образ, плохое кеширование слоёв
RUN apt-get update && \
    apt-get install -y vim git curl python3-pip && \
    pip install --no-cache-dir apache-airflow && \
    pip install --no-cache-dir pandas numpy requests jupyter matplotlib && \
    echo "some debug stuff" > /debug.log

# Не используем многослойные/многоступенчатые сборки

# Не используем существующего пользователя airflow из базового образа

# Стартуем shell, а не конкретный процесс Airflow
CMD ["bash"]
